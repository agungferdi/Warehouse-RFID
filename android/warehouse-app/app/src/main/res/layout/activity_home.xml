<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_bg"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Gradient header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_header"
                android:paddingStart="20dp"
                android:paddingEnd="12dp"
                android:paddingTop="22dp"
                android:paddingBottom="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:text="RFID Warehouse"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_on_brand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:id="@+id/tvHomeStatus"
                        android:text="Loading..."
                        android:textSize="11sp"
                        android:textColor="@color/text_on_brand_muted"
                        android:layout_marginTop="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- KPI row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp"
                    android:weightSum="3">

                    <LinearLayout style="@style/SectionCard" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="6dp">
                        <TextView android:text="AVAILABLE" android:textSize="10sp" android:textColor="@color/text_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:id="@+id/tvKpiAvailable" android:text="0" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/status_available" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout style="@style/SectionCard" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="6dp">
                        <TextView android:text="SOLD" android:textSize="10sp" android:textColor="@color/text_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:id="@+id/tvKpiSold" android:text="0" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/status_sold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout style="@style/SectionCard" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:text="IN TRANSIT" android:textSize="10sp" android:textColor="@color/text_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:id="@+id/tvKpiInTransit" android:text="0" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/status_in_transit" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Pie chart card -->
                <LinearLayout style="@style/SectionCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:text="Stock by Status" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_marginBottom="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <com.github.mikephil.charting.charts.PieChart
                        android:id="@+id/pieChartStatus"
                        android:layout_width="match_parent"
                        android:layout_height="220dp" />
                </LinearLayout>

                <!-- Bar chart card -->
                <LinearLayout style="@style/SectionCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:text="Activity — Last 7 Days" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_marginBottom="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/barChartActivity"
                        android:layout_width="match_parent"
                        android:layout_height="220dp" />
                </LinearLayout>

                <TextView
                    android:text="ACTIONS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/btnTagRegistration"
                    style="@style/ColorButton"
                    android:text="Tag Registration"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btnRecordActivity"
                    style="@style/OutlineButton"
                    android:text="Record Activity" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
