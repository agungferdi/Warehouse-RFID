# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rfid_warehouse?schema=public"

# Signs the web login session cookie (JWT). Use a long random string.
SESSION_SECRET="change-me-to-a-long-random-string"

# Shared secret the Android app sends via the X-API-Key header for all /api/device/* routes.
DEVICE_API_KEY="change-me-device-api-key"

# One-time admin user seed (used by `npm run db:seed`).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
